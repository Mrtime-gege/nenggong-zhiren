# 能工智人 / nenggong-zhiren — example environment.
# Copy to .env and edit. The server loads .env automatically; real environment
# variables always win. Keep .env private.

# ---- Network ---------------------------------------------------------------
HOST=0.0.0.0
PORT=7355
# TLS_CERT=/etc/nginx/certs/fullchain.pem
# TLS_KEY=/etc/nginx/certs/privkey.pem

# 账号/密码保存在项目根目录 users.json（scrypt 哈希，仅保留在本机）。
# 不需要通过环境变量设置用户名或密码。

# ---- Caller API keys (format: key:label,key2:label2) -----------------------
HUMAN_KEYS=change-me-please:local
# Models exposed by /v1/models.
HUMAN_MODELS=human-1,human-1-fast

# ---- Queue / human typing --------------------------------------------------
QUEUE_TIMEOUT_MS=7200000
RESPONSE_TIMEOUT_MS=7200000
STREAM_DELAY_MS=26
MAX_CONCURRENT_PER_KEY=4
RETENTION_MS=1800000
BODY_LIMIT_BYTES=2097152

# ---- Sessions / proxy ------------------------------------------------------
SESSION_TTL_MS=43200000
SESSION_IDLE_MS=7200000
# Set to 1 when TLS terminates at a trusted reverse proxy.
# COOKIE_SECURE=1
# Reverse proxy Host header allowlist (comma separated). The loopback and LAN
# addresses are allowed automatically.
# TRUSTED_HOSTS=ai.example.internal:7355
LOGIN_RATE_WINDOW_MS=300000

# ---- CORS / logging --------------------------------------------------------
CORS_ORIGIN=*
LOG_CONTENT=0

