{
  // ===========================================================================
  // 能工智人 · 运行配置
  //
  // 这里只放“怎么运行”的设置，不放账号密码、调用密钥或聊天内容。
  // 账号保存在 storage.usersFile，调用密钥保存在 storage.apiKeysFile。
  // 修改后重启程序生效；程序不会读取环境变量，也不需要启动参数。
  // ===========================================================================

  "server": {
    // 监听地址。
    //   0.0.0.0   = 同一局域网的人都能访问（默认）
    //   127.0.0.1 = 只允许本机访问
    //   其它      = 指定某一块网卡的地址
    "host": "0.0.0.0",

    // 网页和接口共用的端口。
    // 可选 1–65535；修改后浏览器地址和调用地址要一起改。
    "port": 7355,

    // 登录 Cookie 是否只通过 HTTPS 发送。
    //   "auto" = 根据当前是否为 HTTPS 自动判断（推荐）
    //   true   = 强制只通过 HTTPS
    //   false  = 普通 HTTP 也发送（仅限本机/受控局域网）
    "cookieSecure": "auto",

    // 额外允许的域名，例如通过前置代理访问时：
    //   ["ai.example.internal:7355", "ai.example.internal"]
    // 空数组表示只使用本机、localhost 和当前监听网卡自动生成的地址。
    "trustedHosts": [],

    // 只有来自这些代理地址的 X-Forwarded-For 才会被采信。
    // 留空表示永远使用 TCP remoteAddress（最安全）。
    "trustedProxies": [],

    // 浏览器跨域读取接口的允许来源。
    //   ["*"] = 允许任意来源读取（方便接入，安全边界仍靠调用密钥）
    //   []    = 不允许跨域读取
    //   ["https://app.example.internal"] = 只允许列出的来源
    "corsOrigins": ["*"]
  },

  "storage": {
    // 账号文件。相对路径以项目根目录为基准。
    // 文件只保存密码哈希；启动时不存在会自动创建并生成管理员。
    "usersFile": "users.json",

    // 调用密钥文件。管理员在网页里添加/停用/删除密钥。
    // 文件只保存密钥哈希和名称，不保存明文；权限自动设为 0600。
    "apiKeysFile": "api-keys.json",

    // 活动/已完成请求、认领状态、SSE 日志和幂等记录快照。
    // 重启后恢复活动票据；原 socket 不会恢复，带幂等键的调用方可重连。
    "stateFile": "state.json",

    // 每个调用密钥的分钟/日/月配额计数，重启后保留。
    "usageFile": "usage.json",

    // 管理设置在网页保存后的覆盖值；不存在会自动创建。
    "settingsFile": "settings.json",

    // 管理操作、登录和密钥变更的审计记录文件；按行追加。
    "auditFile": "audit.log",

    // 文件附件存储目录；权限会自动收紧到 0700。
    "attachmentsDir": "attachments",

    // 运行时模型清单。首次启动会从 models.catalog 初始化；之后由「模型」页面维护。
    "modelsFile": "models.json",

    // 服务端共享/个人快捷回复模板。
    "templatesFile": "templates.json",

    // AI 辅助的 API Key（0600，只有管理员能写；不会通过 API 返回）。
    "aiSecretsFile": "ai-secrets.json",

    // AI 辅助的每日限额计数（不保存提示词或回复内容）。
    "aiUsageFile": "ai-usage.json",

    // 已完成票据的 SQLite/FTS5 历史索引；没有 node:sqlite 时自动回退内存搜索。
    "historyFile": "history.db",

    // 票据/幂等记录的 SQLite 状态库；启动时若库为空会导入旧 state.json。
    "stateDb": "state.db"
  },

  "auth": {
    // 登录后最长多久必须重新登录，单位毫秒。
    // 范围 60000–2592000000（1 分钟到 30 天）。
    "sessionTtlMs": 43200000,

    // 登录后多久不操作就自动退出，单位毫秒。
    // 范围 60000–604800000（1 分钟到 7 天）。
    "sessionIdleMs": 7200000,

    // 登录失败计数窗口，单位毫秒。
    // 范围 10000–3600000（10 秒到 1 小时）。
    "loginRateWindowMs": 300000,

    // 同一来源地址在窗口内最多允许的失败次数。
    // 范围 1–1000；达到后暂时拒绝登录。
    "loginIpMaxFailures": 10,

    // 同一用户名在窗口内最多允许的失败次数。
    // 范围 1–1000；达到后暂时拒绝该用户名登录。
    "loginUserMaxFailures": 5
  },

  "queue": {
    // 请求进入等待列表后最多等多久，单位毫秒。
    // 范围 100–86400000（0.1 秒到 24 小时）；超时会告诉调用方稍后重试。
    "waitTimeoutMs": 7200000,

    // 人工接单后最多允许回复多久，单位毫秒。
    // 范围 100–86400000；超时会把这张请求结束掉。
    "responseTimeoutMs": 7200000,

    // 已结束请求在内存里保留多久，单位毫秒。
    // 范围 10000–86400000；便于查看最近记录。状态快照会写入 state.json。
    "retentionMs": 1800000,

    // 全局默认输出速度：每个流式片段的基准停顿，单位毫秒。
    // 模型未单独设置 speedMs 时使用；范围 0–60000。
    // 0 表示不限速；26 是安装默认值，数字越大越慢。
    "streamDelayMs": 26
  },

  "limits": {
    // 每个调用密钥最多同时进行多少个请求。
    // 范围 1–1000；超出会收到“请求太多”的提示。
    "maxConcurrentPerKey": 4,

    // 单个请求体最大字节数。
    // 范围 1024–67108864（1KB 到 64MB）；图片等大内容可适当调高。
    "bodyLimitBytes": 2097152
  },

  "models": {
    // 对外显示的模型名，至少一个。
    // 可以按需要增加，例如 ["human-1", "human-1-fast", "team-a"]。
    "ids": ["human-1", "human-1-fast"],

    // 默认模型名；必须出现在 ids 中。
    "default": "human-1",

    // 模型卡。没有写 catalog 时会按 ids 自动生成最小信息。
    // capabilities 可选值：
    //   text       = 普通文本
    //   streaming  = 逐段返回
    //   tools      = 工具调用
    //   images     = 图片输入
    //   json       = 结构化 JSON 输出
    //   reasoning  = 思考内容
    // deprecated: true 表示不应再接入新调用方；
    // contextWindow / maxOutputTokens 是给调用方看的容量说明。
    "catalog": [
      {
        "id": "human-1",
        "name": "Human 1",
        "description": "人工回复，适合需要人判断的文本任务",
        "contextWindow": 131072,
        "maxOutputTokens": 8192,
        "capabilities": ["text", "streaming", "tools", "images", "json", "reasoning"],
        "deprecated": false
      },
      {
        "id": "human-1-fast",
        "name": "Human 1 Fast",
        "description": "人工回复的快速队列，延迟更低但不保证更快回复",
        "contextWindow": 131072,
        "maxOutputTokens": 8192,
        "capabilities": ["text", "streaming", "tools", "images", "json", "reasoning"],
        "deprecated": false
      }
    ]
  },

  "tls": {
    // 是否由本程序直接提供 HTTPS。
    //   false = 普通 HTTP（默认，适合本机或受控局域网）
    //   true  = 使用下面两个证书文件启用 HTTPS
    // 如果前面已经有反向代理负责 HTTPS，保持 false 即可。
    "enabled": false,

    // 证书链文件路径；启用 TLS 时必填，支持 .pem/.crt。
    "certFile": "",

    // 私钥文件路径；启用 TLS 时必填，支持 .pem/.key。
    "keyFile": ""
  },

  "attachments": {
    // 只允许文本/CSV/JSON、PNG/JPEG/GIF/WebP 和 PDF。
    "enabled": true,
    "maxBytes": 10485760,
    // 每个调用密钥每天最多上传多少字节；0 表示不限。
    "maxBytesPerKeyPerDay": 209715200,
    // 整个附件目录的总容量上限；达到后拒绝新上传，不做自动删除。
    "maxStoreBytes": 2147483648,
    // 可选：上传图片在独立 Python/Pillow worker 中重编码。默认关闭，核心功能不依赖 Python。
    // 开启后如果 worker 不可用会回退原图；基础文件头/尺寸校验仍生效。
    "reencodeImages": false,
    // 可选：PDF 页图按需渲染，需要 Python 包 pypdfium2。默认关闭，关闭时只显示文字预览。
    "pdfPagePreview": false,
    "maxPerRequest": 5,
    // 每个请求最多携带多少个图片 URL；防止一条请求无限塞入远程/data URL 图片。
    "maxImagesPerRequest": 8,
    // 一条请求内所有图片 URL 字符串的总字节上限（含 data URL）。
    "maxImageUrlBytes": 2000000,
    "maxTextPreviewBytes": 262144,
    "maxPdfTextBytes": 262144,
    // 附件保留时间，默认 30 天；定时在上传时清理过期文件。
    "retentionMs": 2592000000
  },

  "audit": {
    // 单个审计日志文件的最大字节数；超过后按 .1/.2/... 轮转。
    "maxBytes": 10485760,
    // 保留多少个历史审计文件；0 不允许，最小 1。
    "keepFiles": 5
  },

  "alerts": {
    // 监控告警：留空 webhookUrl 表示只记录指标，不发送外部通知。
    "webhookUrl": "",
    // 队列积压超过该数量时触发。
    "queueDepth": 10,
    // 最老待接单请求等待超过该毫秒数时触发。
    "oldestWaitMs": 60000,
    // 同类告警冷却时间，避免频繁发送。
    "cooldownMs": 300000
  },

  "features": {
    // 是否记录登录、账号、密钥和设置变更。
    "auditLog": true,

    // 是否在顶部导航显示用量页面。
    "usageDashboard": true,

    // 未登录访客是否可以查看 /guide 新手教程。
    // 登录用户始终可以通过顶部导航在控制台内查看教程。
    "publicGuide": true
  },

  "logging": {
    // 是否把聊天内容写进终端日志。
    //   false = 只记录请求编号、模型、状态等摘要（默认，推荐）
    //   true  = 额外记录聊天内容，方便调试；生产/多人环境不要打开
    "content": false
  }
}
